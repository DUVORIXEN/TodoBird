from PySide6.QtWidgets import (
    QWidget,
    QVBoxLayout,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QFrame,
    QScrollArea,
    QSizePolicy,
)
from PySide6.QtCore import Qt, Signal


class PinnedTaskCard(QFrame):
    """Compact premium card representing one persistent pinned task."""

    edit_requested = Signal(int)
    unpin_requested = Signal(int)
    move_left_requested = Signal(int)
    move_right_requested = Signal(int)

    def __init__(
        self,
        task_row,
        project_name="Inbox",
        can_move_left=False,
        can_move_right=False,
        parent=None,
    ):
        super().__init__(parent)

        self.task_id = int(task_row["id"])
        self.pin_color = task_row.get("pin_color") or "#E95420"

        self.setObjectName("PinnedTaskCard")
        self.setMinimumWidth(245)
        self.setMaximumWidth(320)
        self.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)

        self.setStyleSheet(
            f"""
            QFrame#PinnedTaskCard {{
                background-color: rgba(24, 29, 38, 235);
                border: 1px solid {self.pin_color};
                border-left: 5px solid {self.pin_color};
                border-radius: 10px;
            }}

            QLabel {{
                background: transparent;
            }}

            QPushButton {{
                border: none;
                background: rgba(255,255,255,18);
                border-radius: 5px;
                padding: 3px 6px;
                min-width: 18px;
            }}

            QPushButton:hover {{
                background: rgba(255,255,255,40);
            }}

            QPushButton:disabled {{
                color: rgba(255,255,255,45);
                background: transparent;
            }}
            """
        )

        layout = QVBoxLayout(self)
        layout.setContentsMargins(11, 8, 9, 8)
        layout.setSpacing(5)

        # --------------------------------------------
        # Header: pin + title + controls
        # --------------------------------------------
        top = QHBoxLayout()
        top.setSpacing(5)

        pin = QLabel("📌")
        pin.setStyleSheet("font-size: 16px;")
        top.addWidget(pin)

        title = QLabel(task_row.get("title") or "Untitled")
        title.setWordWrap(False)
        title.setToolTip(task_row.get("title") or "")
        title.setStyleSheet(
            "font-size: 13px; font-weight: 700; color: #F9FAFB;"
        )
        top.addWidget(title, 1)

        left_btn = QPushButton("‹")
        left_btn.setToolTip("Move pinned task left")
        left_btn.setEnabled(can_move_left)
        left_btn.clicked.connect(
            lambda: self.move_left_requested.emit(self.task_id)
        )
        top.addWidget(left_btn)

        right_btn = QPushButton("›")
        right_btn.setToolTip("Move pinned task right")
        right_btn.setEnabled(can_move_right)
        right_btn.clicked.connect(
            lambda: self.move_right_requested.emit(self.task_id)
        )
        top.addWidget(right_btn)

        unpin_btn = QPushButton("×")
        unpin_btn.setToolTip("Unpin task")
        unpin_btn.clicked.connect(
            lambda: self.unpin_requested.emit(self.task_id)
        )
        top.addWidget(unpin_btn)

        layout.addLayout(top)

        # --------------------------------------------
        # Project + workflow information
        # --------------------------------------------
        status = task_row.get("status") or "Inbox"
        progress = max(0, min(int(task_row.get("progress") or 0), 100))
        priority = task_row.get("priority") or "Medium"

        status_icons = {
            "Inbox": "○",
            "Planned": "🗓",
            "In Progress": "▶",
            "Blocked": "⛔",
            "Delayed": "⚠",
            "Moved": "↪",
            "Completed": "✓",
            "Cancelled": "✕",
        }

        status_icon = status_icons.get(status, "○")

        meta = QLabel(
            f"📁 {project_name}   {status_icon} {status}   📊 {progress}%"
        )
        meta.setStyleSheet(
            "font-size: 10px; color: #B8C0CC;"
        )
        layout.addWidget(meta)

        schedule_bits = []

        planned_date = task_row.get("planned_date")
        if planned_date:
            schedule_bits.append(f"📅 {planned_date}")

        start_time = task_row.get("planned_start_time")
        end_time = task_row.get("planned_end_time")

        if start_time or end_time:
            schedule_bits.append(
                f"⏱ {start_time or '--:--'}–{end_time or '--:--'}"
            )

        schedule_bits.append(f"🔥 {priority}")

        schedule = QLabel("   ".join(schedule_bits))
        schedule.setStyleSheet(
            "font-size: 10px; color: #9CA3AF;"
        )
        layout.addWidget(schedule)

        # Entire card can open the task through an explicit button.
        open_btn = QPushButton("Open Task")
        open_btn.setCursor(Qt.PointingHandCursor)
        open_btn.setStyleSheet(
            f"""
            QPushButton {{
                color: #FFFFFF;
                background: {self.pin_color};
                font-weight: 700;
                border-radius: 6px;
                padding: 5px 10px;
            }}
            QPushButton:hover {{
                border: 1px solid rgba(255,255,255,140);
            }}
            """
        )
        open_btn.clicked.connect(
            lambda: self.edit_requested.emit(self.task_id)
        )
        layout.addWidget(open_btn)


class PinnedPrioritiesWidget(QFrame):
    """
    Reusable premium Pinned Priorities strip.

    Persistence is intentionally performed as narrow SQL updates so pin actions
    cannot accidentally overwrite task schedule, dependency or workflow data.
    """

    edit_requested = Signal(int)
    changed = Signal()

    def __init__(self, db_manager, parent=None):
        super().__init__(parent)

        self.db_manager = db_manager

        self.setObjectName("PinnedPrioritiesPanel")
        self.setStyleSheet(
            """
            QFrame#PinnedPrioritiesPanel {
                background-color: rgba(255,255,255,7);
                border: 1px solid rgba(148,163,184,40);
                border-radius: 12px;
            }
            """
        )

        outer = QVBoxLayout(self)
        outer.setContentsMargins(12, 9, 12, 10)
        outer.setSpacing(7)

        # --------------------------------------------
        # Header
        # --------------------------------------------
        header = QHBoxLayout()

        self.title_label = QLabel("📌  Pinned Priorities")
        self.title_label.setStyleSheet(
            "font-size: 14px; font-weight: 800;"
        )

        self.count_label = QLabel("0 pinned")
        self.count_label.setStyleSheet(
            "font-size: 11px; color: #9CA3AF;"
        )

        hint = QLabel("Edit any task → 📌 Pin this task")
        hint.setStyleSheet(
            "font-size: 10px; color: #7F8A99;"
        )

        header.addWidget(self.title_label)
        header.addWidget(self.count_label)
        header.addStretch()
        header.addWidget(hint)

        outer.addLayout(header)

        # --------------------------------------------
        # Horizontal pinned card strip
        # --------------------------------------------
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setHorizontalScrollBarPolicy(
            Qt.ScrollBarAsNeeded
        )
        self.scroll.setVerticalScrollBarPolicy(
            Qt.ScrollBarAlwaysOff
        )
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setMinimumHeight(126)
        self.scroll.setMaximumHeight(145)

        self.content = QWidget()
        self.cards_layout = QHBoxLayout(self.content)
        self.cards_layout.setContentsMargins(1, 2, 1, 2)
        self.cards_layout.setSpacing(9)
        self.cards_layout.setAlignment(Qt.AlignLeft)

        self.scroll.setWidget(self.content)
        outer.addWidget(self.scroll)

        self.refresh_data()

    # ========================================================
    # DATA
    # ========================================================
    def _get_projects(self):
        try:
            rows = self.db_manager.get_all_projects()
        except Exception:
            rows = []

        return {
            int(row.get("id")): row.get("name", "Inbox")
            for row in rows
            if row.get("id") is not None
        }

    def _get_pinned_rows(self):
        with self.db_manager.get_connection() as conn:
            rows = conn.execute(
                """
                SELECT *
                FROM tasks
                WHERE is_pinned = 1
                ORDER BY
                    CASE
                        WHEN pin_position IS NULL OR pin_position <= 0
                        THEN 2147483647
                        ELSE pin_position
                    END ASC,
                    id DESC;
                """
            ).fetchall()

        return [dict(row) for row in rows]

    def refresh_data(self):
        # Clear existing cards
        while self.cards_layout.count():
            item = self.cards_layout.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.deleteLater()

        rows = self._get_pinned_rows()
        projects = self._get_projects()

        self.count_label.setText(
            f"{len(rows)} pinned"
        )

        if not rows:
            empty = QLabel(
                "No pinned priorities yet. "
                "Open a task and enable 📌 Pin this task."
            )
            empty.setAlignment(Qt.AlignCenter)
            empty.setStyleSheet(
                """
                color: #7F8A99;
                font-size: 11px;
                padding: 24px 18px;
                """
            )
            self.cards_layout.addWidget(empty)
            self.cards_layout.addStretch()
            return

        for index, row in enumerate(rows):
            project_name = projects.get(
                int(row.get("project_id") or 1),
                "Inbox",
            )

            card = PinnedTaskCard(
                row,
                project_name=project_name,
                can_move_left=index > 0,
                can_move_right=index < len(rows) - 1,
                parent=self.content,
            )

            card.edit_requested.connect(
                self.edit_requested.emit
            )
            card.unpin_requested.connect(
                self.unpin_task
            )
            card.move_left_requested.connect(
                lambda task_id, direction=-1:
                self.move_task(task_id, direction)
            )
            card.move_right_requested.connect(
                lambda task_id, direction=1:
                self.move_task(task_id, direction)
            )

            self.cards_layout.addWidget(card)

        self.cards_layout.addStretch()

    # ========================================================
    # PIN ACTIONS
    # ========================================================
    def unpin_task(self, task_id: int):
        with self.db_manager.get_connection() as conn:
            conn.execute(
                """
                UPDATE tasks
                SET is_pinned = 0,
                    pin_position = 0,
                    updated_at = CURRENT_TIMESTAMP
                WHERE id = ?;
                """,
                (task_id,),
            )
            conn.commit()

        self._normalize_positions()
        self.refresh_data()
        self.changed.emit()

    def move_task(self, task_id: int, direction: int):
        rows = self._get_pinned_rows()
        ids = [int(row["id"]) for row in rows]

        if task_id not in ids:
            return

        current = ids.index(task_id)
        target = current + direction

        if target < 0 or target >= len(ids):
            return

        ids[current], ids[target] = ids[target], ids[current]

        with self.db_manager.get_connection() as conn:
            for pos, pinned_id in enumerate(ids, start=1):
                conn.execute(
                    """
                    UPDATE tasks
                    SET pin_position = ?,
                        updated_at = CURRENT_TIMESTAMP
                    WHERE id = ?;
                    """,
                    (pos, pinned_id),
                )
            conn.commit()

        self.refresh_data()
        self.changed.emit()

    def _normalize_positions(self):
        rows = self._get_pinned_rows()

        with self.db_manager.get_connection() as conn:
            for pos, row in enumerate(rows, start=1):
                conn.execute(
                    """
                    UPDATE tasks
                    SET pin_position = ?
                    WHERE id = ?;
                    """,
                    (pos, int(row["id"])),
                )
            conn.commit()
