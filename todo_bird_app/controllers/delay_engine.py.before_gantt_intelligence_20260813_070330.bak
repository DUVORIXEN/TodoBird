from enum import Enum
from datetime import datetime, date, time
from typing import Dict, Any, Tuple, Optional
import logging

from todo_bird_app.models.task import Task, TaskStatus

logger = logging.getLogger(__name__)

class TimingStatus(Enum):
    COMPLETED_BEFORE_TIME = "Completed Before Time"
    COMPLETED_ON_TIME = "Completed On Time"
    SLIGHT_DELAY = "Slight Delay"
    MODERATE_DELAY = "Moderate Delay"
    SEVERE_DELAY = "Severe Delay"
    VERY_SEVERE_DELAY = "Very Severe Delay"

class DelayEngine:
    """
    Plan vs Actual delay analysis engine.
    Calculates delay metrics, completion timing status, and justification requirements.
    """
    def __init__(self, settings_manager):
        self.settings_manager = settings_manager

    def get_thresholds(self) -> Dict[str, Any]:
        tol = int(self.settings_manager.get("on_time_tolerance_minutes", 5))
        slight = int(self.settings_manager.get("slight_delay_minutes", 15))
        mod = int(self.settings_manager.get("moderate_delay_minutes", 30))
        sev = int(self.settings_manager.get("severe_delay_minutes", 60))
        vsev_pct = float(self.settings_manager.get("very_severe_delay_percentage", 50.0))

        # Validate threshold ordering
        if not (tol <= slight <= mod <= sev):
            logger.warning("Delay thresholds not in logical order. Restoring default ordering.")
            tol, slight, mod, sev = 5, 15, 30, 60

        return {
            "on_time_tolerance": tol,
            "slight_delay": slight,
            "moderate_delay": mod,
            "severe_delay": sev,
            "very_severe_percentage": vsev_pct,
            "require_justification_moderate": bool(self.settings_manager.get("require_justification_moderate", False)),
            "require_justification_severe": bool(self.settings_manager.get("require_justification_severe", True)),
        }

    def analyze_task_timing(self, task: Task) -> Tuple[TimingStatus, int, float]:
        """
        Analyzes a task and returns (TimingStatus, delay_minutes, delay_percentage).
        """
        t = self.get_thresholds()

        # Parse planned duration in minutes
        planned_dur = task.estimated_duration if task.estimated_duration > 0 else 30
        actual_dur = task.actual_duration if task.actual_duration > 0 else planned_dur

        # Calculate time difference if timestamps are present
        delay_mins = 0
        if task.planned_end_time and task.actual_end_time:
            try:
                p_end = datetime.strptime(task.planned_end_time, "%H:%M")
                a_end = datetime.strptime(task.actual_end_time, "%H:%M")
                diff_sec = (a_end - p_end).total_seconds()
                delay_mins = int(diff_sec // 60)
            except Exception:
                delay_mins = actual_dur - planned_dur
        else:
            delay_mins = actual_dur - planned_dur

        delay_pct = (delay_mins / planned_dur * 100.0) if planned_dur > 0 else 0.0

        if delay_mins < 0:
            status = TimingStatus.COMPLETED_BEFORE_TIME
        elif delay_mins <= t["on_time_tolerance"]:
            status = TimingStatus.COMPLETED_ON_TIME
        elif delay_mins <= t["slight_delay"]:
            status = TimingStatus.SLIGHT_DELAY
        elif delay_mins <= t["moderate_delay"]:
            status = TimingStatus.MODERATE_DELAY
        elif delay_mins <= t["severe_delay"] and delay_pct < t["very_severe_percentage"]:
            status = TimingStatus.SEVERE_DELAY
        else:
            status = TimingStatus.VERY_SEVERE_DELAY

        return status, delay_mins, delay_pct

    def requires_justification(self, timing_status: TimingStatus) -> bool:
        t = self.get_thresholds()
        if timing_status in (TimingStatus.SEVERE_DELAY, TimingStatus.VERY_SEVERE_DELAY) and t["require_justification_severe"]:
            return True
        if timing_status == TimingStatus.MODERATE_DELAY and t["require_justification_moderate"]:
            return True
        return False
