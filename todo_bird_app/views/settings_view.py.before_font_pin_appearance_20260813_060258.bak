        safety_card = QFrame()
        safety_card.setObjectName("CardWidget")
        s_layout = QFormLayout(safety_card)
        s_title = QLabel("🛡️ UX Safety & Task Deletion Protection")
        s_title.setStyleSheet("font-size: 16px; font-weight: 700;")
