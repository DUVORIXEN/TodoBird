    def get_all_projects(self) -> List[Dict[str, Any]]:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT * FROM projects ORDER BY name ASC;")
            rows = cursor.fetchall()
            return [dict(r) for r in rows]

    def insert_project(self, project_dict: Dict[str, Any]) -> int:
        query = """
            INSERT INTO projects (name, color, icon, description, is_archived)
            VALUES (:name, :color, :icon, :description, :is_archived);
        """
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute(query, project_dict)
            conn.commit()
            return cursor.lastrowid

    # -----------------------------
    # Settings Operations
    # -----------------------------
    def get_setting(self, key: str, default: str = "") -> str:
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("SELECT value FROM settings WHERE key = ?;", (key,))
            row = cursor.fetchone()
            return row[0] if row else default

    def set_setting(self, key: str, value: str):
        with self.get_connection() as conn:
            cursor = conn.cursor()
            cursor.execute("""
                INSERT INTO settings (key, value) VALUES (?, ?)
                ON CONFLICT(key) DO UPDATE SET value=excluded.value;
            """, (key, value))
            conn.commit()
