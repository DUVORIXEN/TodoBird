import os
import sys
import subprocess
import logging
from pathlib import Path
from typing import Tuple

logger = logging.getLogger(__name__)

DESKTOP_ENTRY_TEMPLATE = """[Desktop Entry]
Name=Todo Bird
Comment=Offline Personal Productivity Companion
Exec={python_exec} {app_script}
Icon={icon_path}
WorkingDirectory={work_dir}
Terminal=false
Type=Application
Categories=Office;Utility;Productivity;
StartupNotify=true
"""

class DesktopLauncherService:
    """
    Manages Linux desktop application launcher (.desktop), desktop shortcut,
    and login autostart for Ubuntu 24.04 without requiring sudo.
    """
    @staticmethod
    def create_desktop_launchers() -> Tuple[bool, str]:
        try:
            base_dir = Path(__file__).parent.parent.parent
            python_exec = base_dir / "venv" / "bin" / "python"
            app_script = base_dir / "todo_bird_app" / "app.py"
            icon_path = base_dir / "todo_bird_app" / "assets" / "icons" / "todo-bird.png"

            # Create default icon if missing
            icon_path.parent.mkdir(parents=True, exist_ok=True)
            if not icon_path.exists():
                # Copy or write dummy icon asset placeholder
                with open(icon_path, "wb") as f:
                    f.write(b"")

            content = DESKTOP_ENTRY_TEMPLATE.format(
                python_exec=str(python_exec.resolve()),
                app_script=str(app_script.resolve()),
                icon_path=str(icon_path.resolve()),
                work_dir=str(base_dir.resolve()),
            )

            # 1. Install to ~/.local/share/applications/todo-bird.desktop
            apps_dir = Path.home() / ".local" / "share" / "applications"
            apps_dir.mkdir(parents=True, exist_ok=True)
            apps_file = apps_dir / "todo-bird.desktop"

            with open(apps_file, "w", encoding="utf-8") as f:
                f.write(content)
            os.chmod(apps_file, 0o755)

            # 2. Install to ~/Desktop/Todo Bird.desktop
            desktop_dir = Path.home() / "Desktop"
            if desktop_dir.exists():
                desktop_file = desktop_dir / "Todo Bird.desktop"
                with open(desktop_file, "w", encoding="utf-8") as f:
                    f.write(content)
                os.chmod(desktop_file, 0o755)

            # Update desktop database
            subprocess.run(["update-desktop-database", str(apps_dir)], check=False, stderr=subprocess.DEVNULL)
            logger.info("Desktop launcher created successfully")
            return True, f"Launcher created at {apps_file}"
        except Exception as e:
            logger.error(f"Failed to create desktop launcher: {e}")
            return False, str(e)

    @staticmethod
    def set_autostart(enabled: bool) -> bool:
        try:
            autostart_dir = Path.home() / ".config" / "autostart"
            autostart_file = autostart_dir / "todo-bird.desktop"

            if enabled:
                autostart_dir.mkdir(parents=True, exist_ok=True)
                base_dir = Path(__file__).parent.parent.parent
                python_exec = base_dir / "venv" / "bin" / "python"
                app_script = base_dir / "todo_bird_app" / "app.py"
                icon_path = base_dir / "todo_bird_app" / "assets" / "icons" / "todo-bird.png"

                content = DESKTOP_ENTRY_TEMPLATE.format(
                    python_exec=str(python_exec.resolve()),
                    app_script=str(app_script.resolve()),
                    icon_path=str(icon_path.resolve()),
                    work_dir=str(base_dir.resolve()),
                )
                with open(autostart_file, "w", encoding="utf-8") as f:
                    f.write(content)
                os.chmod(autostart_file, 0o755)
            else:
                if autostart_file.exists():
                    autostart_file.unlink()
            return True
        except Exception as e:
            logger.error(f"Error updating autostart: {e}")
            return False
